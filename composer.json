{
  "name": "rnscommerce/codeception-module-webdriver-bidi",
  "description": "A Codeception module that adds WebDriver BiDi to the WebDriver module: actionability checks, assertions that retry, page readiness, event-driven waits and user contexts.",
  "type": "library",
  "license": "MIT",
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/rnscommerce/php-webdriver-bidi"
    }
  ],
  "require": {
    "php": "^8.1",
    "codeception/codeception": "^5.0",
    "codeception/module-webdriver": "^3.2 || ^4.0",
    "php-webdriver/webdriver": "^1.15",
    "rnscommerce/php-webdriver-bidi": "^0.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6 || ^10.5 || ^11",
    "phpstan/phpstan": "^2",
    "squizlabs/php_codesniffer": "^3"
  },
  "autoload": {
    "psr-4": {
      "Rnscommerce\\Codeception\\WebDriverBiDi\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Rnscommerce\\Codeception\\WebDriverBiDi\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:integration": "phpunit --testsuite integration",
    "stan": [
      "codecept build --config tests/Integration/Project --quiet",
      "phpstan analyse"
    ],
    "cs": "phpcs",
    "cs-fix": "phpcbf",
    "check": [
      "@cs",
      "@stan",
      "@test"
    ]
  }
}
